---
source: src/adapter/shell/hook_script.rs
assertion_line: 339
expression: script
---
# muster's prompt hook for fish. Load it from ~/.config/fish/config.fish with:
#   muster shell-init fish | source
# A pane `muster open` made only shows a process, so its shell never
# occupies the project.
if status is-interactive; and not set -q __muster_hook; and not set -q MUSTER_OPEN_ARG_0
    set -g __muster_hook 1
    set -g __muster_bin /usr/local/bin/muster
    set -g __muster_notes /home/user/.local/state/muster/shells
    # The load's start in nanoseconds, then the pid of a process it spawns,
    # which breaks a tie of a coarse clock: a later load always compares
    # greater, so a late report from before an exec is told apart.
    set -l now (command date +%s%N 2>/dev/null)
    if not string match -qr '^[0-9]{19}$' -- "$now"
        set now (command date +%s 2>/dev/null)
        if string match -qr '^[0-9]{1,10}$' -- "$now"
            set now "$now"000000000
        else
            set now 0
        end
    end
    set -g __muster_load $now
    set -l spawned (command sh -c 'echo "$$"' 2>/dev/null)
    string match -qr '^[0-9]{1,10}$' -- "$spawned"; or set spawned $fish_pid
    set -g __muster_load_pid $spawned
    set -g __muster_seq 0
    # The folder of the last prompt, and the first prompt's time, in
    # nanoseconds, at which the shell was seen in it: a project registered
    # after that was registered around the shell, not walked into.
    set -g __muster_pwd
    set -g __muster_arrived
    set -gx MUSTER_SHELL_PID $fish_pid

    function __muster_prompt --on-event fish_prompt
        set -l status_kept $status
        if test "$PWD" != "$__muster_pwd"
            set -g __muster_pwd $PWD
            set -g __muster_arrived (command date +%s%N 2>/dev/null)
            string match -qr '^[0-9]{19}$' -- "$__muster_arrived"; or set -g __muster_arrived
        end
        set -l arrived
        test -n "$__muster_arrived"; and set arrived --arrived $__muster_arrived
        set __muster_seq (math $__muster_seq + 1)
        for note in $__muster_notes/$fish_pid-*.note
            test -f $note; or continue
            while read -l line
                printf '%s\n' "$line"
            end <$note
            command rm -f -- $note
        end
        if test -x $__muster_bin
            command $__muster_bin __shell-report --pid $fish_pid --load $__muster_load \
                --load-pid $__muster_load_pid --seq $__muster_seq $arrived </dev/null >/dev/null 2>&1 &
            disown 2>/dev/null
        end
        return $status_kept
    end
end
